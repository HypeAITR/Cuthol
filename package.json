{
  "name": "cuthol",
  "version": "0.3.5",
  "description": "Agent-first open-source non-linear video editor (NLE) powered by HyperFrames and open media standards.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cuthol": "./dist/cli.js",
    "cuthol-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "src/live/ui",
    "skills",
    "examples",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:serial": "node --import ./dist/test/test_setup.js --test --test-concurrency=1 dist/test/*.test.js",
    "cuthol": "node dist/cli.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.9.15",
    "puppeteer-core": "25.14.0"
  }
}
